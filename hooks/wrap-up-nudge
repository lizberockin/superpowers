#!/usr/bin/env bash
# UserPromptSubmit hook: deterministic trigger for superpowers:compound-memory.
# Trigger phrases are read from the skill itself so the two cannot drift.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL="${SCRIPT_DIR}/../skills/compound-memory/SKILL.md"
MAX_PROMPT_CHARS=120

input="$(cat)"

if command -v jq >/dev/null 2>&1; then
  prompt="$(printf '%s' "$input" | jq -r '.prompt // empty' 2>/dev/null || true)"
else
  prompt="$input"
fi

[ -n "$prompt" ] || exit 0
[ "${#prompt}" -le "$MAX_PROMPT_CHARS" ] || exit 0
[ -r "$SKILL" ] || exit 0

phrases="$(awk '/<trigger_phrases>/{on=1;next} /<\/trigger_phrases>/{on=0} on && /^- "/{sub(/^- "/,"");sub(/"$/,"");print}' "$SKILL")"
[ -n "$phrases" ] || exit 0

lower="$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')"
matched=""
while IFS= read -r phrase; do
  [ -n "$phrase" ] || continue
  p="$(printf '%s' "$phrase" | tr '[:upper:]' '[:lower:]')"
  if printf '%s' "$lower" | grep -qE "(^|[^[:alnum:]])${p//./\\.}([^[:alnum:]]|$)"; then
    matched="$phrase"
    break
  fi
done <<< "$phrases"

[ -n "$matched" ] || exit 0

context="The user's message ('${matched}') signals the session is wrapping up. Invoke superpowers:compound-memory now, before your final reply."
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
exit 0
